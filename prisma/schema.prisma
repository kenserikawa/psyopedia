generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────

enum Era {
  WWII
  COLD_WAR
  MODERN
  DIGITAL_AGE
}

enum OperationType {
  ASSASSINATION
  PROPAGANDA
  DECEPTION
  INFLUENCE_OP
  FALSE_FLAG
  INFILTRATION
  MIND_CONTROL
  SURVEILLANCE
  DISINFORMATION
}

enum Outcome {
  SUCCESSFUL
  FAILED
  PARTIAL
  ONGOING
  UNKNOWN
}

enum OperationStatus {
  DECLASSIFIED
  LEAKED
  ALLEGED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SourceType {
  GOVERNMENT
  ACADEMIC
  JOURNALISM
  BOOK
  LEAKED_DOC
  VIDEO
  WEBSITE
}

enum ContributionType {
  NEW_OPERATION
  EDIT_OPERATION
  ADD_SOURCE
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

// ─── Models ─────────────────────────────────────────

model Operation {
  id               String            @id @default(cuid())
  slug             String            @unique
  slugEs           String            @unique
  title            String
  titleEs          String
  aliases          String[]
  icebergLevel     Int
  era              Era
  types            OperationType[]
  actors           String[]
  targets          String[]
  outcome          Outcome
  status           OperationStatus
  bodyEn           String
  bodyEs           String
  excerpt          String
  excerptEs        String
  coverImage       String?
  sources          Source[]
  relatedOps       Operation[]       @relation("RelatedOps")
  relatedTo        Operation[]       @relation("RelatedOps")
  tags             Tag[]
  contributions    Contribution[]
  comments         Comment[]
  viewCount        Int               @default(0)
  moderationStatus ModerationStatus  @default(APPROVED)
  contributedBy    User?             @relation("ContributedOperations", fields: [contributedById], references: [id])
  contributedById  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Source {
  id          String     @id @default(cuid())
  url         String?
  title       String
  type        SourceType
  credibility Int
  operation   Operation  @relation(fields: [operationId], references: [id], onDelete: Cascade)
  operationId String
}

model Tag {
  id         String      @id @default(cuid())
  slug       String      @unique
  name       String
  nameEs     String
  operations Operation[]
}

model Contribution {
  id            String           @id @default(cuid())
  type          ContributionType
  operation     Operation?       @relation(fields: [operationId], references: [id])
  operationId   String?
  proposedData  Json
  diffData      Json?
  reviewNote    String?
  status        ModerationStatus @default(PENDING)
  submittedBy   User             @relation("SubmittedContributions", fields: [submittedById], references: [id])
  submittedById String
  reviewedBy    User?            @relation("ReviewedContributions", fields: [reviewedById], references: [id])
  reviewedById  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model Comment {
  id          String           @id @default(cuid())
  body        String
  operation   Operation        @relation(fields: [operationId], references: [id], onDelete: Cascade)
  operationId String
  author      User             @relation(fields: [authorId], references: [id])
  authorId    String
  status      ModerationStatus @default(PENDING)
  createdAt   DateTime         @default(now())
}

model User {
  id                    String         @id @default(cuid())
  name                  String?
  email                 String         @unique
  emailVerified         DateTime?
  image                 String?
  role                  UserRole       @default(USER)
  reputation            Int            @default(0)
  contributions         Contribution[] @relation("SubmittedContributions")
  reviewedContributions Contribution[] @relation("ReviewedContributions")
  comments              Comment[]
  operationsAdded       Operation[]    @relation("ContributedOperations")
  accounts              Account[]
  sessions              Session[]
  createdAt             DateTime       @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
